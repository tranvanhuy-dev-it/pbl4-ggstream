# Copy this file to .env and fill in real local values.
# .env is gitignored — never commit real secrets.

# --- Server ---
SERVER_PORT=8080

# --- Database (PostgreSQL, installed directly on the machine — no Docker) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/meet_platform
DATABASE_USERNAME=meet_user
DATABASE_PASSWORD=changeme

# development | validate (never use create/create-drop against a real DB)
JPA_DDL_AUTO=update

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- JWT ---
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440

# --- WebSocket signaling ---
WS_HEARTBEAT_INTERVAL_SECONDS=10
WS_HEARTBEAT_TIMEOUT_SECONDS=30
WS_RECONNECT_GRACE_SECONDS=15

# --- TURN ---
# Blank TURN_HOST/TURN_SECRET means the ICE servers endpoint gracefully
# degrades to STUN-only. See docs/networking/turn-setup.md to install Coturn.
TURN_HOST=
TURN_PORT=3478
TURN_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
STUN_URL=stun:stun.l.google.com:19302

# --- SFU (LiveKit) ---
# Blank LIVEKIT_URL/LIVEKIT_API_KEY/LIVEKIT_API_SECRET means SFU-mode
# meetings can't issue tokens (Mesh-mode meetings are unaffected either
# way). See docs/networking/sfu-setup.md to run livekit-server.exe locally.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Livestream (FFmpeg) ---
# LIVESTREAM_FFMPEG_PATH defaults to "ffmpeg" (resolved via PATH) if unset.
# See docs/networking/livestream-setup.md to install FFmpeg.
LIVESTREAM_FFMPEG_PATH=ffmpeg
LIVESTREAM_OUTPUT_DIR=./livestream-output
